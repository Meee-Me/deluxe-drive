{
  // The Deluxe server: Deluxe Main's data (accounts, sign-ins, every website's
  // data) at /main/api, and Deluxe Drive (its page, file contents and share
  // links). Deluxe Main's website is on Vercel (MAIN_SITE).
  "name": "deluxe-drive",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",

  // The drive's own files (index.html, js/, styles.css, vendor/ ...). What is
  // left out is listed in .assetsignore.
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s/*", "/main/api/*"]
  },

  // HUB: Deluxe Drive's file contents and share links. MAIN: Deluxe Main's
  // accounts, sign-ins and saved data. Both SQLite.
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "Hub" },
      { "name": "MAIN", "class_name": "Main" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Hub"] },
    { "tag": "v2", "new_sqlite_classes": ["Main"] }
  ],

  "vars": {
    // Deluxe Main's website (on Vercel). People sign in there.
    "MAIN_SITE": "https://deluxe-main.vercel.app",
    // Extra website addresses allowed to sign in, as JSON, e.g.
    // {"mail": ["https://deluxe-mail.vercel.app"]}
    "APP_ORIGINS": "{}"
  },
  // Secrets (npx wrangler secret put NAME): APP_KEY_MAIL, the key Deluxe Mail's
  // server uses to save mail in Deluxe Main.

  // File contents are kept in the Durable Object's database by default, which
  // needs nothing set up and works on a free account. For a large drive, enable
  // R2, create a bucket, and add it here: the drive then stores files in R2.
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "deluxe-drive-files" }]
}
