{
  // Deluxe Drive: the page, plus the server that keeps the files. Accounts are on Deluxe Main.
  "name": "deluxe-drive",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // Lets this Worker call Deluxe Main's workers.dev address on the same account.
  "compatibility_flags": ["global_fetch_strictly_public"],

  // The drive's own files (index.html, js/, styles.css, vendor/ ...). What is
  // left out is listed in .assetsignore.
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/s/*"]
  },

  // Deluxe Main holds the accounts and checks every sign-in key.
  "vars": { "MAIN_URL": "https://deluxe-main.deluxelordd.workers.dev" },
  // Optional, once both Workers are on the same Cloudflare account:
  // "services": [{ "binding": "MAIN", "service": "deluxe-main" }],

  // File contents and share links (SQLite).
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],

  // File contents are kept in the Durable Object's database by default, which
  // needs nothing set up and works on a free account. For a large drive, enable
  // R2, create a bucket, and add it here: the drive then stores files in R2.
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "deluxe-drive-files" }]
}
